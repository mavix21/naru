{
  "name": "@naru/app",
  "version": "0.0.1",
  "private": true,
  "description": "Naru web app",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "build": "next build",
    "preview": "next start",
    "lint": "oxlint --react-plugin --nextjs-plugin --jsx-a11y-plugin --deny-warnings src next.config.ts postcss.config.mjs",
    "format": "oxfmt .",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:profiles:browser": "vitest run --config vitest.profiles.config.ts",
    "profiles:sync": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/sync-profiles.ts",
    "splits:maintain": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/maintain-splits.ts",
    "swaps:check": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/check-swap-market.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.119",
    "@base-ui/react": "^1.8.0",
    "@clerk/backend": "3.20.1",
    "@clerk/nextjs": "7.9.7",
    "@naru/backend": "workspace:*",
    "@shadcn/react": "0.3.1",
    "@stellar/stellar-sdk": "17.1.0",
    "@tabler/icons-react": "^3.47.0",
    "@tanstack/react-query": "^5.90.17",
    "ai": "7.0.116",
    "buffer": "6.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.2",
    "convex": "1.46.0",
    "next": "^16.3.6",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "server-only": "0.0.1",
    "shadcn": "^4.21.0",
    "smart-account-kit": "0.8.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@shadcn/lint": "^0.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "convex-test": "0.0.60",
    "husky": "^9.1.7",
    "jsqr": "^1.4.0",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": "oxlint --react-plugin --nextjs-plugin --jsx-a11y-plugin --fix",
    "**/*": "oxfmt"
  }
}

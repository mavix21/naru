# Naru smart accounts and contracts use Stellar Testnet.
# Never prefix sponsor secrets with NEXT_PUBLIC_.
NARU_SMART_ACCOUNT_ORIGIN=http://localhost:3000
NARU_SMART_ACCOUNT_RP_ID=localhost
# Dedicated, Friendbot-funded testnet source account (S...); server only.
NARU_SMART_ACCOUNT_SPONSOR_SECRET=
# Separate, funded testnet recipient (G...). Sends are fixed at 0.1 test XLM.
NARU_SMART_ACCOUNT_RECIPIENT=
# Transaction intents, signed envelopes, sponsor claims and budgets use Convex.
# Deploy backend/convex before enabling payments in a new environment.

# User-facing payments require Clerk and a saved companion. Outside local dev,
# also enable this switch and use a stable HTTPS ORIGIN with matching RP_ID.
NARU_SMART_ACCOUNT_ENABLED=false
# Only for the retained validation HTTP gate, not user-facing onboarding.
# Generate a random token of at least 32 characters; server only.
NARU_SMART_ACCOUNT_ACCESS_TOKEN=

# Server-only key shared with the Convex payments module. Generate a random
# value of at least 32 characters and set the same value on the Convex
# deployment so only the trusted server can record payment and sponsor state:
#   npx convex env set NARU_PAYMENTS_KEY <value>
NARU_PAYMENTS_KEY=

# Clerk DEVELOPMENT, including the Vercel demo. Obtain both keys from the SAME
# Clerk Development instance. Merge into an existing .env.local; don't overwrite
# existing Stellar secrets.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Server only. Must be sk_test_..., never NEXT_PUBLIC_ or a Convex variable.
CLERK_SECRET_KEY=
# Canonical origin for public profile links and QR codes (HTTPS in production).
# Defaults to NARU_SMART_ACCOUNT_ORIGIN when omitted.
NARU_PUBLIC_ORIGIN=http://localhost:3000
# Clerk webhook endpoint: /api/webhooks/clerk; user.created and user.updated.
CLERK_WEBHOOK_SIGNING_SECRET=
# The selected Convex deployment's HTTPS URL (*.convex.cloud).
# Set this in the app even if the Convex CLI writes a URL in backend/.env.local.
NEXT_PUBLIC_CONVEX_URL=
# /sign-in, /sign-up and the home fallback are configured in code.
# CLERK_JWT_ISSUER_DOMAIN belongs on the Convex deployment, not here.

# Conversational companion. Server-only AI Gateway credential.
AI_GATEWAY_API_KEY=
NARU_AI_MODEL=anthropic/claude-haiku-4.5

# Server-only Soroswap API key: https://api.soroswap.finance/login
# Use a zero-fee partner profile. Quotes with partner fees are rejected.
# Swaps are pinned to Stellar Testnet, official USDC and direct Soroswap routes.
# SDEX and the alternate USDC token in Soroswap's quickstart are not supported.
# If the API returns No path found, Naru reads a live quote from the verified
# Soroswap router for the same assets. The review card identifies this source.
NARU_SOROSWAP_API_KEY=

# The environment to use `development`, `testing`, `staging`, `production`
STELLAR_SCAFFOLD_ENV=development

# Location of the config files for this project for the scaffold stellar CLI.
# Learn more at https://developers.stellar.org/docs/tools/cli/stellar-cli#stellar-config-dir
XDG_CONFIG_HOME=".config"

# Prefix with "NEXT_PUBLIC_" to make available in frontend files
# Which Stellar network to use in the frontend: local, testnet, futurenet, or mainnet
# More on Stellar networks: https://developers.stellar.org/docs/networks

NEXT_PUBLIC_STELLAR_NETWORK="LOCAL"
# The Stellar network passphrase, this is local
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Standalone Network ; February 2017"
# The Stellar network RPC URL. this is local
NEXT_PUBLIC_STELLAR_RPC_URL="http://localhost:8000/rpc"
# The Stellar Horizon URL. this is local
NEXT_PUBLIC_STELLAR_HORIZON_URL="http://localhost:8000"

# NEXT_PUBLIC_STELLAR_NETWORK="TESTNET"
# NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
# NEXT_PUBLIC_STELLAR_RPC_URL="https://soroban-testnet.stellar.org"
# NEXT_PUBLIC_STELLAR_HORIZON_URL="https://horizon-testnet.stellar.org"

# NEXT_PUBLIC_STELLAR_NETWORK="PUBLIC"
# NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Public Global Stellar Network ; September 2015"
# NEXT_PUBLIC_STELLAR_RPC_URL=
# NEXT_PUBLIC_STELLAR_HORIZON_URL=

# Slice 1: /dev/smart-account. Separate from the scaffold network above;
# this flow pins Stellar TESTNET regardless of NEXT_PUBLIC_STELLAR_*.
# See docs/smart-account-slice-1.md. Never prefix sponsor secrets with NEXT_PUBLIC_.
NARU_SMART_ACCOUNT_ORIGIN=http://localhost:3000
NARU_SMART_ACCOUNT_RP_ID=localhost
# Dedicated, Friendbot-funded testnet source account (S...); server only.
NARU_SMART_ACCOUNT_SPONSOR_SECRET=
# Separate, funded testnet recipient (G...). Sends are fixed at 0.1 test XLM.
NARU_SMART_ACCOUNT_RECIPIENT=
# Local dev defaults to app/.naru-smart-account.sqlite.
# Outside dev, REQUIRED: absolute path on persistent local disk; parent must exist.
# NARU_SMART_ACCOUNT_DB=/var/lib/naru/smart-account.sqlite

# Outside local development the page/API return 404 unless explicitly enabled.
# Use a stable HTTPS ORIGIN, matching RP_ID, and HTTP Basic username "naru".
NARU_SMART_ACCOUNT_ENABLED=false
# Generate a random token of at least 32 characters; server only.
NARU_SMART_ACCOUNT_ACCESS_TOKEN=

{
  "name": "@stellar-scaffold/ui",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "app",
    "app-lib",
    "app-lib/clients/*",
    "e2e"
  ],
  "scripts": {
    "dev": "npm start",
    "prestart": "node scripts/dev-guard.mjs",
    "start": "pnpm --dir app watch",
    "lint": "npm run lint --workspaces --if-present",
    "format": "oxfmt . --ignore-path=.oxfmtignore",
    "format:check": "oxfmt . --check --ignore-path=.oxfmtignore"
  },
  "devDependencies": {
    "oxfmt": "^0.70.0"
  },
  "packageManager": "pnpm@11.25.0"
}

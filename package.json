{
  "name": "@stellar-scaffold/ui",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "app",
    "app-lib",
    "app-lib/clients/*",
    "e2e"
  ],
  "scripts": {
    "predev": "node scripts/dev-guard.mjs",
    "dev": "pnpm --filter @stellar-scaffold/ui-react watch",
    "prestart": "node scripts/dev-guard.mjs",
    "start": "pnpm --dir app watch",
    "lint": "pnpm -r --if-present run lint && oxlint app-lib e2e scripts --deny-warnings",
    "format": "oxfmt . --ignore-path=.oxfmtignore",
    "format:check": "oxfmt . --check --ignore-path=.oxfmtignore"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.85.0",
    "oxfmt": "^0.70.0",
    "oxlint": "1.85.0"
  },
  "packageManager": "pnpm@11.25.0"
}

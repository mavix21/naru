# Convex CLI only. Run `pnpm --dir backend exec convex dev --configure` from
# the repository root and select a CLOUD DEVELOPMENT deployment. The CLI
# creates backend/.env.local; do not replace an existing configuration.
CONVEX_DEPLOYMENT=dev:your-development-deployment

# Set the deployment's *.convex.cloud URL as NEXT_PUBLIC_CONVEX_URL in
# app/.env.local separately.

# Configure this on the Convex DASHBOARD (Settings > Environment Variables),
# not in this file. Same Clerk Development instance as the app's pk_test/sk_test.
# CLERK_JWT_ISSUER_DOMAIN=https://your-instance.clerk.accounts.dev

# No CLERK_SECRET_KEY or CONVEX_DEPLOY_KEY is needed in this workspace.
# Builds use checked-in generated files and never watch or deploy.
